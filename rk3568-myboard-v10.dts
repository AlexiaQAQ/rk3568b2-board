// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * RK3568B2 自定义板 V10
 *
 * 硬件概要：
 *   - SoC     : RK3568B2 (FCCSP, 2.0GHz)
 *   - DDR     : LPDDR4X 4GB x32 (RS1G32LO4D2BDS-53BT, 实际跑 1560MHz)
 *   - PMIC    : RK809-5 @ I2C0 0x20 + TCS4525 @ I2C0 0x1c (VDD_CPU)
 *   - 存储    : SD 卡启动（暂无 eMMC）
 *   - 网络    : 1x RTL8211F-CG (GMAC0, RGMII) + AP6212 WiFi/BT
 *   - 显示    : HDMI
 *   - USB     : Type-C OTG (仅 USB2.0) + USB3.0 Host
 *   - 调试    : UART2 @ 1500000
 *
 * 设计思路：直接复用 Rockchip RK3568 EVB1 参考设计（电源树/PHY/USB 均已验证），
 *          只把本板没有的外设关掉，并覆盖板级差异。
 *
 * 名字里的 "myboard" 请全局替换成你实际的板名。
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568-evb1-ddr4-v10.dtsi"

/ {
	model = "My RK3568B2 Board V10";
	compatible = "rockchip,rk3568-myboard-v10", "rockchip,rk3568";

	/*
	 * 4GB LPDDR4X：/memory 由 u-boot 在启动时自动填充，不要在这里硬编码。
	 * DDR 时序/容量由 rkbin 的 rk3568_ddr_1560MHz_v1.26.bin 负责。
	 */

	/* 本板无 VGA，EVB 的 VGA 电源会去抢 GPIO0_D5，禁用 */
	vcc3v3_vga: vcc3v3-vga {
		status = "disabled";
	};

	/* 本板无 M.2/PCIe，EVB 的 PCIe 3.3V 会去抢 GPIO0_D4，禁用 */
	vcc3v3_pcie: vcc3v3-pcie {
		status = "disabled";
	};
};

/* ==================== GPU / NPU：首板先禁用 ==================== */
/*
 * GPU：mali 驱动读 GPU 寄存器曾触发 synchronous external abort，系统挂死，
 * 当时测得 VDD_GPU = 0V，因此禁用。
 * 但 eMMC 上板后 regulator_summary 显示 vdd_gpu = 900mV 且有 consumer，
 * 供电疑似本来就正常（之前的 0V 可能是在系统挂死状态下量的），待单独验证再打开。
 */
&gpu {
	/*
	 * 2026-10-26 换 SoC 后确认可用。
	 *
	 * 前一版结论是「GPU 电源域起不来」（failed to get ack on domain 'gpu'，
	 * 随后 kbase 读寄存器触发 synchronous external abort，VDD_GPU 实测 0.18V）。
	 * 换掉那颗 RK3568 后，同一块板子、同一版固件：
	 *
	 *   mali fde60000.gpu: Register LUT 00070200 initialized for GPU arch 0x00070400
	 *   mali fde60000.gpu: GPU identified as 0x2 arch 7.4.0 r1p0 status 0
	 *   /dev/mali0 存在，devfreq 注册成功，频率 200~800MHz
	 *
	 * 结论：**旧 SoC 的 GPU 电源域损坏**，不是板子供电或配置问题。
	 * 其余属性（mali-supply、OPP、电源域）都继承 EVB1，不用改。
	 */
	status = "okay";
};

&rknpu {
	/*
	 * 2026-10-25 打开。判断依据：
	 *   regulator_summary: vdd_npu 900mV、有 consumer
	 *   kernel: CONFIG_ROCKCHIP_RKNPU=y（驱动本身就编进去了）
	 * EVB dtsi 里 rknpu-supply = <&vdd_npu>、rknpu_mmu 也都是 okay，直接继承。
	 *
	 * interrupt-names 必须补：rk356x.dtsi 的 npu 节点只写了 interrupts，
	 * 没有 interrupt-names。6.1 的驱动会先按名字取 "npu_irq"，取不到才回退到
	 * 按索引取——回退是成功的，但 dmesg 里会留一条
	 *   "error -ENXIO: IRQ npu_irq not found"
	 * 补上名字这条警告就没了。
	 */
	interrupt-names = "npu_irq";
	status = "okay";
};

/* ==================== 以太网：GMAC1 / RTL8211F ==================== */
/*
 * 原理图确认 RTL8211F 接 GMAC1（m1 复用）：
 *   MDC/MDIO -> GPIO4_B6/B7，TXD/RXD -> GPIO4_A0~A6 + GPIO3_D6/D7
 *   PHY 复位 -> GMAC1_RSTN_GPIO3_B0
 * GMAC0 的引脚被 SDMMC1(WiFi) 与 UART1(BT) 占用，必须关闭。
 */
&gmac0 {
	status = "disabled";
};

&mdio0 {
	status = "disabled";
};

&gmac1 {
	snps,reset-gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&mdio1 {
	status = "okay";
};

/* ==================== 存储：只有 SD 卡 ==================== */
&sdmmc0 {
	/*
	 * 首板实测：SDR104(148.5MHz) 下出现
	 *   EXT4-fs error ... Error while async write back metadata
	 *   WARNING at dw_mci_request_end (WARN_ON(host->cmd || host->data))
	 * 说明高速模式下读写不稳（自制板走线/负载与 EVB 不同）。
	 *
	 * 补焊后复测 4-bit 仍出现 I/O error 与 dw_mci_request_end WARN（72 次），
	 * 判断 DAT1~DAT3 仍有问题，回退 1-bit 保证系统可用。
	 * 彻底解决需逐条检查 SD 座到 SoC 的 DAT1/2/3 焊接与走线。
	 */
	max-frequency = <50000000>;
	bus-width = <1>;		/* DAT1~3 仍不稳定，先用单线保证可用 */
	/delete-property/ sd-uhs-sdr104;
	status = "okay";
};

/*
 * eMMC：2026-10-25 贴片。
 * 引脚与总线宽度沿用 EVB1 的 8-bit / non-removable 配置，这里只打开 status。
 * 若只焊了 4 条 DAT（DAT0~DAT3），需要把 bus-width 改成 <4>，否则初始化会降速或失败。
 */
&sdhci {
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	max-frequency = <200000000>;
	status = "okay";
};

&sfc {
	status = "disabled";	/* 无 SPI NAND */
};

&nandc0 {
	status = "disabled";
};

/* ==================== IO 电压域：与 EVB 有 2 处不同，必须覆盖 ==================== */
/*
 * RK3568 的 pmu_io_domains 驱动实际只处理：pmuio2、vccio1、vccio3、vccio4、vccio5、vccio6、vccio7
 * （pmuio1 和 vccio2 在 soc_data_rk3568_pmu 里是 empty case，写了也不生效）
 *
 * 你的板子：
 *   VCCIO1 = LDO4  vccio_acodec 3.0V   → 与 EVB 相同
 *   VCCIO2 = VCCIO_FLASH，0Ω 短接 VCC_1V8 (1.8V)
 *           → 驱动 case 3 (vccio2) 是空实现，电压由 FLASH_VOL_SEL 引脚硬件决定，
 *             本板该引脚接 VCC3V3_PMU（高电平）= 1.8V 模式，与供电一致，无需配置。
 *             注意：/usr/bin/list-iodomain.sh 会打印 "vccio2_vsel: 3.3V"，那是 GRF 寄存器
 *             的复位默认值（没人写过），不代表实际电平，可以忽略。
 *   VCCIO3 = LDO5  vccio_sd            → 与 EVB 相同
 *   VCCIO4 = VCCIO_WL，0Ω 短接 VCC_1V8 (1.8V) → EVB 是 3.3V，必须改
 *   VCCIO5 = VCC_3V3 (3.3V)            → 与 EVB 相同
 *   VCCIO6 = VCC_1V8 (1.8V)            → EVB 是 3.3V，必须改
 *   VCCIO7 = VCC_3V3 (3.3V)            → 与 EVB 相同
 */
&pmu_io_domains {
	status = "okay";

	/* PMUIO2 你没说明；EVB 上是 3.3V。若是 1.8V 请改成 <&vcc_1v8> */
	pmuio2-supply = <&vcc3v3_pmu>;

	vccio1-supply = <&vccio_acodec>;	/* 3.0V */
	/* vccio2 驱动不处理，不写 */
	vccio3-supply = <&vccio_sd>;		/* SD 卡 IO，1.8~3.3V 可切 */

	vccio4-supply = <&vcc_1v8>;		/* ★ 本板 1.8V（EVB 是 3.3V） */
	vccio5-supply = <&vcc_3v3>;		/* 3.3V */
	vccio6-supply = <&vcc_1v8>;		/* ★ 本板 1.8V（EVB 是 3.3V） */
	vccio7-supply = <&vcc_3v3>;		/* 3.3V */
};

/* ==================== WiFi / BT：AP6212 ==================== */
/*
 * WiFi SDIO = SDMMC1（EVB 用的是 sdmmc2）
 * BT       = UART1 m0 + 硬件流控（EVB 用的是 uart8）
 *
 * 引脚对照（已核对 pinctrl 定义，互不冲突）：
 *   SDMMC1  CLK=GPIO2_B0  CMD=GPIO2_A7  D0-D3=GPIO2_A3~A6
 *   UART1   TX =GPIO2_B4  RX =GPIO2_B3  RTSN=GPIO2_B5  CTSN=GPIO2_B6
 *   WL_REG_ON    = GPIO2_B1      WL_HOST_WAKE = GPIO2_B2
 *   BT_REG_ON    = GPIO2_B7      (BT_RST_N)
 *   BT_WAKE      = GPIO2_C1
 *   BT_HOST_WAKE = GPIO2_C0
 */
/* 调试串口 UART2 @ 1500000：rk356x.dtsi 里默认 disabled，必须显式打开。
 * 不打开的话板子能跑，但串口一个字都没有，排障会很难受。
 */
&uart2 {
	status = "okay";
};

&uart8 {
	status = "disabled";
};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
};

/* WL_REG_ON = GPIO2_B1，WL_HOST_WAKE = GPIO2_B2（EVB 分别是 GPIO3_D5 / GPIO3_D4） */
&pinctrl {
	wifi-pwrseq-myboard {
		wifi_enable_h_myboard: wifi-enable-h-myboard {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wlan-myboard {
		wifi_host_wake_irq_myboard: wifi-host-wake-irq-myboard {
			rockchip,pins = <2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

/*
 * WL_REG_ON（GPIO2_B1）原本被两个独占驱动同时引用：
 *   sdio_pwrseq.reset-gpios   (mmc-pwrseq-simple, gpiod 独占)
 *   wireless_wlan.WIFI,poweren_gpio (rfkill-wlan, gpio_request 独占)
 * 谁先 probe 谁拿到，另一个静默失败；本板该脚有下拉，无人驱动时保持低电平，
 * 导致 AP6212 永远不上电、26MHz 不起振、SDIO 扫不到。
 *
 * 改由独立 always-on 稳压器统一驱动，两个驱动都不再持有该 GPIO。
 */
/ {
	wl_reg_on: wl-reg-on {
		compatible = "regulator-fixed";
		regulator-name = "wl_reg_on";
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc_1v8>;
	};
};

&sdio_pwrseq {
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_enable_h_myboard>;
	/delete-property/ reset-gpios;
};

&sdmmc1 {
	max-frequency = <150000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	sd-uhs-sdr104;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	status = "okay";
};

&sdmmc2 {
	status = "disabled";
};

&wireless_wlan {
	status = "okay";
	wifi_chip_type = "ap6212";
	/* WL_REG_ON 由 wl_reg_on 稳压器控制，这里不再重复申请同一个 GPIO */
	/delete-property/ WIFI,poweren_gpio;
	WIFI,host_wake_irq = <&gpio2 RK_PB2 GPIO_ACTIVE_HIGH>;	/* WL_HOST_WAKE */
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_host_wake_irq_myboard>;
};

/*
 * EVB 的 wireless_bluetooth 节点绑死在 uart8 的引脚上（uart_rts_gpios=GPIO2_B1，
 * 那是本板的 WL_REG_ON），无法通过覆盖属性改干净，所以关掉它、另起一个节点。
 */
&wireless_bluetooth {
	status = "disabled";
};

/ {
	bt_platdata: bt-platdata {
		compatible = "bluetooth-platdata";
		bt_port = "/dev/ttyS1";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";

		BT,reset_gpio    = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;	/* BT_REG_ON / BT_RST_N */
		BT,wake_gpio     = <&gpio2 RK_PC1 GPIO_ACTIVE_HIGH>;	/* HOST_WAKE_BT */
		BT,wake_host_irq = <&gpio2 RK_PC0 GPIO_ACTIVE_HIGH>;	/* BT_WAKE_HOST */

		pinctrl-names = "default";
		pinctrl-0 = <&bt_reg_on_gpio &bt_wake_gpio &bt_host_wake_gpio>;
		status = "okay";
	};
};

&pinctrl {
	bt-myboard {
		bt_reg_on_gpio: bt-reg-on-gpio {
			rockchip,pins = <2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		bt_host_wake_gpio: bt-host-wake-gpio {
			rockchip,pins = <2 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

/* ==================== 显示：只保留 HDMI ==================== */
&hdmi {
	status = "okay";
};

&hdmi_sound {
	status = "okay";
};

&route_hdmi {
	status = "okay";
};

&dsi0 {
	status = "disabled";
};

&dsi1 {
	status = "disabled";
};

&edp {
	status = "disabled";
};

&route_dsi0 {
	status = "disabled";
};

&route_edp {
	status = "disabled";
};

&dsi0_panel {
	status = "disabled";
};

&dsi1_panel {
	status = "disabled";
};

/* 背光/屏供电：EVB 用 GPIO0_C7 等，本板无屏，禁用避免抢 GPIO */
&vcc3v3_lcd0_n {
	status = "disabled";
};

&vcc3v3_lcd1_n {
	status = "disabled";
};

/* ==================== 外部接口：不用 PCIe / SATA ==================== */
&pcie3x2 {
	status = "disabled";
};

&pcie30phy {
	status = "disabled";
};

&sata2 {
	status = "disabled";
};

/* ==================== USB ==================== */
/*
 * EVB 默认：usbdrd30 = OTG(type-C)，usbhost30 = USB3.0 HOST
 * 你的板子：OTG 只走 USB2.0（D+/D-），不需要 SS 差分对
 *
 * 注意：vcc5v0_host / vcc5v0_otg 这两个 regulator 在 EVB 上分别占
 *       GPIO0_A6 / GPIO0_A5 做 VBUS 使能，务必按你的原理图改或删除。
 */
&usbdrd_dwc3 {
	dr_mode = "otg";
	maximum-speed = "high-speed";	/* Type-C 只有 USB2.0，限制在 HS 更稳 */
	status = "okay";
};

&usbhost_dwc3 {
	dr_mode = "host";
	maximum-speed = "super-speed";	/* USB3.0 Host */
	status = "okay";
};

/* ==================== 关掉 EVB 上有、本板没有的东西 ==================== */

/* 摄像头 */
&csi2_dphy_hw {
	status = "disabled";
};

&csi2_dphy0 {
	status = "disabled";
};

&rkisp {
	status = "disabled";
};

&rkisp_mmu {
	status = "disabled";
};

&rkisp_vir0 {
	status = "disabled";
};

&vcc_camera {
	status = "disabled";
};

/* 触摸 */
&gt1x {
	status = "disabled";
};

&hynitron {
	status = "disabled";
};

/* 板载 codec：本板未提音频，先关；若要用耳机/喇叭把这里改回 okay */
&rk809_sound {
	status = "disabled";
};

/* EVB 的心跳灯在 GPIO0_C0，本板若无此灯就关掉 */
&leds {
	status = "disabled";
};

/* ==================== 电源树：已确认 ==================== */
/*
 * 已核对（2026-10-21）：
 *   SW1=vdd_logic  SW2=vdd_gpu  SW3=vcc_ddr  SW4=vdd_npu
 *   LDO1=vdda0v9_image(0.9V)   LDO2=vdda_0v9(0.9V)    LDO3=vdda0v9_pmu(0.9V)
 *   LDO4=vccio_acodec(3.0V)    LDO5=vccio_sd(1.8~3.3) LDO6=vcc3v3_pmu(3.3V)
 *   LDO7=vcca_1v8(1.8V)        LDO8=vcca1v8_pmu(1.8V) LDO9=vcca1v8_image(1.8V)
 *   VDD_CPU = TCS4525 @0x1c    PMIC_INT = GPIO0_A3
 * => regulator 树直接继承，不做修改。
 *
 * 注意：LDO8 (vcca1v8_pmu) 与 VCC1V8_DDR 之间用 0Ω 短接，
 *       即 DDR 的 VDD1 由 PMU 域 1.8V 供电。这样掉电/待机时 DDR 能保持自刷新，
 *       设计上是合理的，但要确认 LDO8 的电流余量（DDR 满载时实测纹波）。
 *
 * 仍需确认：
 * 1) PMUIO2 的实际电压（当前按 EVB 的 3.3V 配置）。
 * 2) 主输入：EVB 是 dc_12v 12V 输入。你的板子若是 5V 输入，
 *    要改 vcc3v3_sys / vcc5v0_sys 的 vin-supply。
 */
